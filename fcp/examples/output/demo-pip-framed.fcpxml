                            <video ref="r2" lane="2" offset="0s" start="0s" duration="599599/30000s" name="PIP (replace me)">
                                <adjust-transform position="313.2 556.8" scale="0.32 0.32" rotation="-2" />
                                <filter-video ref="r4" name="Shape Mask">
                                    <param name="Radius" value="507.6 902.4" />
