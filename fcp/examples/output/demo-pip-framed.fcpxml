    <library>
        <event name="fcpkit">
            <project name="PIP Kit">
                <sequence format="r1" tcStart="0s" tcFormat="NDF" audioLayout="stereo" audioRate="48k" duration="599599/30000s">
                    <spine>
                        <video ref="r2" offset="0s" start="0s" duration="599599/30000s" name="Main (replace me)">
                            <video ref="r3" lane="1" offset="0s" start="0s" duration="599599/30000s" name="PIP frame">
                                <adjust-transform position="313.2 556.8" scale="0.34963 0.336667" rotation="-2" />
                                <param name="Fill Color" value="1.0 1.0 1.0" />
                                <param name="Roundness" value="0.6" />
                                <param name="Outline" value="0" />
